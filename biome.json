{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!**/*.md", "!guidelines/tokens"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useVueMultiWordComponentNames": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "packages/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noAutofocus": "off",
            "useSemanticElements": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "useFocusableInteractive": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useAriaPropsSupportedByRole": "off",
            "noLabelWithoutControl": "off",
            "useAriaPropsForRole": "off",
            "noSvgWithoutTitle": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**", "packages/*/test/**", "docs/test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
