{
  "name": "@m3-expressive/vue",
  "version": "0.1.0",
  "description": "Material 3 Expressive components, design tokens and dynamic color theming for Vue 3.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@m3-expressive/core": "^0.1.0",
    "@m3-expressive/styles": "^0.1.0"
  },
  "devDependencies": {
    "vue": "3.5.13"
  }
}
