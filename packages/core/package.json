{
  "name": "@m3-expressive/core",
  "version": "0.1.0",
  "description": "Framework-agnostic Material 3 Expressive dynamic color math, spring motion physics, shape morphing and theme utilities.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0"
  }
}
